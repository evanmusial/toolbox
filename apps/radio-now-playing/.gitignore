.venv/
venv/
__pycache__/
*.py[cod]
*.sqlite*
*.db
*.db-*
/daemon.lock
*.pid
/receipts/
/SOURCE_SHA256.json

# Recovery archives can contain credentials.
/backups/
*.tar
*.tar.gz
*.tgz
*.zip
._*
